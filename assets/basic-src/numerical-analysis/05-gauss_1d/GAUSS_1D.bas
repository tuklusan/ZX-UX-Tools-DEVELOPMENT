  10 DIM a(4): DIM b(4)
  20 FOR i=1 TO 4
  30 READ a(i)
  40 NEXT i
  50 FOR i=1 TO 4
  60 READ b(i)
  70 NEXT i
  80 FOR v=1 TO 2
  90 LET ss=0
 100 FOR i=1 TO 4
 110 LET z1=.5-.5*a(i): LET z2=.5+.5*a(i)
 120 LET y1=EXP z1: LET y2=EXP z2
 130 IF v=2 THEN LET y1=4/(1+z1*z1): LET y2=4/(1+z2*z2)
 140 LET ss=ss+b(i)*(y1+y2)
 150 NEXT i
 160 LET res=.5*ss: LET exact=EXP (1)-1
 170 IF v=2 THEN LET exact=3.14159265
 180 PRINT "GAUSS ";v;" ";res;" ";ABS (res-exact)
 200 NEXT v
 210 PRINT "DONE GAUSS_1D"
 220 STOP 
