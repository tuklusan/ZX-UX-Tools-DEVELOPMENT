1500 REM 
1510 REM draw landshape
1520 REM input di
1530 LET ly=8+(di=1)*16
1540 LET lx=((rt+24)*(di=1))+(lt*(di=-1))
1550 LET up=255-(di=-1)*255
1560 IF di=1 THEN PLOT rt,8: DRAW INK 2;24,16
1570 PLOT lx,ly
1580 LET a=RND: LET ry=((a<=.6)-(a>.6))*(INT (RND*48)+1)
