  10 CLS 
  20 PRINT "TRIP INTO THE FUTURE"
  30 LET t=INT (RND*100+25)
  40 PRINT "YOU WISH TO RETURN ";t
  50 PRINT "YEAR IN THE FUTURE."
  60 PRINT 
  70 PRINT "SPEED OF SHIP (0-1)"
  80 INPUT v
  90 IF v>=1 OR v<=0 THEN GO TO 70
 100 PRINT "DISTANCE OF TRIP"
