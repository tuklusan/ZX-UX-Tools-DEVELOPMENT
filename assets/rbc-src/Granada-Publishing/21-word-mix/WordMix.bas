   5 REM WORD-MIX BY VINCE APPS
  20 PRINT AT 10,1; INK 5; FLASH 1;"STOP THE TAPE THEN PRESS A KEY"; FLASH 0
  25 PAUSE 0
  26 BORDER 0: PAPER 0: INK 6: CLS 
  30 RANDOMIZE 
  40 LET SC=0
  50 LET TR=0
  60 DIM W$(60,10)
  80 FOR J=1 TO 60
  90 READ W$(J)
 100 NEXT J
 110 CLS 
 120 PRINT PAPER 6; INK 9;AT 1,5;"WORDS: ";TR
 130 PRINT PAPER 1; INK 7;AT 1,17;"SCORE: ";SC
 140 LET R1=INT (RND*60)+1
 150 LET R2=INT (RND*60)+1
 160 IF R2=R1 THEN GO TO 150
 170 LET M1=1
 180 LET M2=1
 190 PRINT AT 6,8;
 200 IF RND>0.5 THEN GO TO 246
 208 IF M1>10 THEN GO TO 280
 210 IF W$(R1,M1)=" " THEN GO TO 230
 220 PRINT PAPER 2; INK 7;W$(R1,M1);
 230 LET M1=M1+1
 240 GO TO 280
 246 IF M2>10 THEN GO TO 280
 250 IF W$(R2,M2)=" " THEN GO TO 270
 260 PRINT PAPER 2; INK 7;W$(R2,M2);
 270 LET M2=M2+1
 280 IF M1<10 OR M2<10 THEN GO TO 200
 290 PRINT PAPER 5; INK 0;AT 10,4;"WHAT ARE THE TWO WORDS?"
 300 INPUT A$,B$
 310 IF A$="QUIT" THEN GO TO 420
 320 IF LEN (A$)<10 THEN LET A$=A$+" ": GO TO 320
 330 IF LEN (B$)<10 THEN LET B$=B$+" ": GO TO 330
 340 IF A$<>W$(R1) AND A$<>W$(R2) THEN GO TO 370
 350 PRINT PAPER 0; INK 6;AT 14,3;"YOUR FIRST WORD IS CORRECT"
 360 LET A$=""
 370 IF B$<>W$(R1) AND B$<>W$(R2) THEN GO TO 400
 380 PRINT PAPER 0; INK 5;AT 16,3;"YOUR SECOND WORD IS CORRECT"
 390 LET B$=""
 394 PAUSE 200
 400 LET SC=SC+(A$="")+(B$="")
 410 IF A$="" AND B$="" THEN GO TO 110
 420 PRINT PAPER 2; INK 7;AT 18,4;"THE TWO WORDS WERE"
 430 PRINT PAPER 1; INK 7;AT 20,4;W$(R1)
 432 PRINT PAPER 1; INK 7;AT 20,15;W$(R2)
 434 PAUSE 500
 440 GO TO 110
