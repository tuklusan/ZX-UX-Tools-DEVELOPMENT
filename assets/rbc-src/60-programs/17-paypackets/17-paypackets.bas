 800 REM **CALCULATE A(X)
 810 LET X=0: LET A=A*100: FOR J=11 TO 1 STEP -1
 820 LET A(J)=0: IF X=1 THEN GO TO 850
 830 IF (A-V(J)*100)<0 THEN GO TO 850
 835 LET A=INT (A-INT (V(J)*100.0000001)): IF A=0 THEN LET X=1
 836 REM ** PREVIOUS LINE       PREVENTS DECIMAL PLACE OVERFLOW ERROR
 840 LET A(J)=A(J)+1: IF X=0 THEN GO TO 830
 850 NEXT J
 860 FOR J=1 TO 11: LET A(J)=A(J)*B: NEXT J
 870 FOR J=1 TO 11: LET B(J)=B(J)+A(J): NEXT J
 880 RETURN 
8999 REM ** NON-CRASHABLE       NUMERIC INPUT
9000 INPUT LINE A$: LET FL=0: LET FL2=0: LET DP=0
9005 IF A$="" THEN GO TO 9000
9010 FOR X=1 TO LEN A$: IF CODE A$(X)=46 THEN LET FL2=FL2+1: LET DP=X
9020 IF (CODE A$(X)<48 OR CODE A$(X)>57) AND CODE A$(X)<>46 THEN LET FL=1
9030 NEXT X: IF LEN A$-DP<>2 OR FL OR FL2>1 OR LEN A$>6 THEN BEEP .5,-3: PRINT #1; FLASH 1;"PLEASE REINPUT": PAUSE 50: BEEP .02,12: GO TO 9000
9040 IF PACKET THEN IF DP OR LEN A$>2 THEN LET FL=1: GO TO 9030
9060 RETURN 
