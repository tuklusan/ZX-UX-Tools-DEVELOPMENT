( FOUR POSITIVE NODES OF EIGHT-POINT GAUSS-LEGENDRE. )
CREATE GX 183 , 526 , 797 , 960 ,
CREATE GW 363 , 314 , 222 , 101 ,
VARIABLE GM VARIABLE GSUM VARIABLE GZ
: GAUSS
  3 1 DO I GM ! 0 GSUM !
    4 0 DO
      1000 I GX A@ - 2 / GZ !
      GZ @ GM @ FTEST
      1000 I GX A@ + 2 / GM @ FTEST +
      I GW A@ F* GSUM @ + GSUM !
    LOOP
    ." GAUSS " GM @ . GSUM @ 2 / . CR
  LOOP ;
GAUSS
